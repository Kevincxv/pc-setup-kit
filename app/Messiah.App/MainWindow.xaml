<Window x:Class="Messiah.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Messiah" Width="1040" Height="780" MinWidth="480" MinHeight="440" WindowStartupLocation="Manual"
        Background="{DynamicResource c.Bg}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="{DynamicResource c.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <!-- dashboard.ps1's window: the top bar with the tabs, a line for what's running, the page, a note at the bottom -->
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="MainCol" Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition x:Name="ChatCol" Width="0"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="TopBar" Margin="24,14,24,4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image x:Name="Logo" Width="26" Height="26" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock x:Name="AppName" Text="Messiah" FontSize="17" FontWeight="SemiBold" FontFamily="{DynamicResource f.Display}" VerticalAlignment="Center"/>
      </StackPanel>
      <Border Grid.Column="1" Background="{DynamicResource c.Seg}" CornerRadius="10" Padding="4" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0"><StackPanel x:Name="NavList" Orientation="Horizontal"/></Border>
      <Button x:Name="AiPill" AutomationProperties.Name="Ask Claude" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
    <Border x:Name="NowBar" Grid.Row="1" Visibility="Collapsed" Margin="24,8,24,0" Padding="14,8" CornerRadius="10" Background="{DynamicResource c.Seg}" Cursor="Hand" HorizontalAlignment="Center" MaxWidth="3400">
      <StackPanel Orientation="Horizontal">
        <Ellipse x:Name="NowDot" Width="8" Height="8" Fill="{DynamicResource c.Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBlock x:Name="NowText" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </Border>
    <ScrollViewer x:Name="Scroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Body" MaxWidth="3400" Margin="24,14,24,28">
        <DockPanel x:Name="Header" Margin="2,4,0,18">
          <Border x:Name="SubBox" DockPanel.Dock="Right" Background="{DynamicResource c.Seg}" CornerRadius="8" Padding="3" VerticalAlignment="Center" Margin="16,0,0,0"><WrapPanel x:Name="SubNav"/></Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold" FontFamily="{DynamicResource f.Display}"/>
            <TextBlock x:Name="PageSub" Foreground="{DynamicResource c.Sub}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
        <StackPanel x:Name="PageContent"/>
      </StackPanel>
    </ScrollViewer>
    <Border x:Name="NoteBar" Grid.Row="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" MaxWidth="640" Margin="24,0,24,20" Padding="16,10" CornerRadius="10" Background="{DynamicResource c.Toast}" BorderBrush="{DynamicResource c.Border}" BorderThickness="1">
      <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="Black"/></Border.Effect>
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" FontFamily="{DynamicResource f.Icons}" FontSize="14" Foreground="{DynamicResource c.Accent}" VerticalAlignment="Center" Margin="0,0,10,0" Text="&#xE946;"/>
        <Button x:Name="NoteAct" Content="Restart" DockPanel.Dock="Right" Visibility="Collapsed" Style="{StaticResource AccentBtn}" Margin="14,0,0,0" Padding="12,5" VerticalAlignment="Center"/>
        <TextBlock x:Name="Note" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
    <GridSplitter x:Name="ChatSplit" Grid.Column="1" Grid.RowSpan="3" Width="7" Margin="0,0,-4,0" Panel.ZIndex="5" Style="{StaticResource Splitter}" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Cursor="SizeWE" Focusable="False" Visibility="Collapsed" ToolTip="Drag to make the chat wider or narrower"/>
    <Border x:Name="ChatPanel" Grid.Column="2" Grid.RowSpan="3" Visibility="Collapsed" AllowDrop="True" Background="{DynamicResource c.Card}" BorderBrush="{DynamicResource c.Border}" BorderThickness="1,0,0,0">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="12,16,12,10">
          <Button x:Name="ChatMenu" AutomationProperties.Name="Chats and earlier conversations" DockPanel.Dock="Left" ToolTip="Chats and earlier conversations"/>
          <Button x:Name="ChatClose" AutomationProperties.Name="Close the chat" DockPanel.Dock="Right" ToolTip="Close the chat (Claude keeps working)"/>
          <Button x:Name="ChatNew" AutomationProperties.Name="New conversation" DockPanel.Dock="Right" ToolTip="New conversation (Ctrl+T) - the one before stays under Earlier conversations"/>
          <Button x:Name="ChatMode" DockPanel.Dock="Right"/>
          <Button x:Name="ChatRemote" AutomationProperties.Name="Open this chat in the browser (Remote Control)" DockPanel.Dock="Right" Visibility="Collapsed"/>
          <DockPanel VerticalAlignment="Center" Margin="10,0,6,0">
            <TextBlock DockPanel.Dock="Left" FontFamily="{DynamicResource f.Icons}" FontSize="16" Foreground="{DynamicResource c.Accent}" VerticalAlignment="Center" Text="&#xE99A;" Margin="0,0,10,0"/>
            <StackPanel x:Name="ChatTitleBox">
              <TextBlock x:Name="ChatTitle" Text="Claude" FontSize="16" FontWeight="SemiBold" FontFamily="{DynamicResource f.Display}" TextTrimming="CharacterEllipsis" ToolTip="Double-click to rename this chat"/>
              <TextBlock x:Name="ChatStatus" FontSize="12" Foreground="{DynamicResource c.Sub}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DockPanel>
        </DockPanel>
        <WrapPanel x:Name="ChatTabs" DockPanel.Dock="Top" Margin="14,0,14,6" Visibility="Collapsed"/>
        <Border x:Name="ChatFind" DockPanel.Dock="Top" Visibility="Collapsed" Margin="14,0,14,6" CornerRadius="8" Background="{DynamicResource c.Btn}" BorderBrush="{DynamicResource c.Accent}" BorderThickness="1" Padding="10,1,3,1">
          <DockPanel>
            <Button x:Name="ChatFindClose" AutomationProperties.Name="Close find" DockPanel.Dock="Right"/>
            <Button x:Name="ChatFindNext" AutomationProperties.Name="Next match" DockPanel.Dock="Right"/>
            <Button x:Name="ChatFindPrev" AutomationProperties.Name="Previous match" DockPanel.Dock="Right"/>
            <TextBlock x:Name="ChatFindCount" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource c.Sub}" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <TextBox x:Name="ChatFindBox" AutomationProperties.Name="Find in this chat" FontSize="13" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource c.Text}" CaretBrush="{DynamicResource c.Text}" VerticalAlignment="Center" Padding="0,5"/>
          </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Margin="14,6,14,14" CornerRadius="12" Background="{DynamicResource c.Btn}" BorderBrush="{DynamicResource c.Border}" BorderThickness="1" Padding="12,6,6,6">
          <DockPanel>
            <WrapPanel x:Name="ChatAttach" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,2,0,4"/>
            <Button x:Name="ChatSend" AutomationProperties.Name="Send" DockPanel.Dock="Right" VerticalAlignment="Bottom"/>
            <Grid>
              <TextBlock x:Name="ChatHint" Text="Ask Claude anything - paste or drop screenshots and files" Foreground="{DynamicResource c.Sub}" FontSize="14" Margin="3,6,0,0" IsHitTestVisible="False"/>
              <TextBox x:Name="ChatInput" AutomationProperties.Name="Message to Claude" AutomationProperties.HelpText="Enter sends; Shift+Enter for a new line; Up arrow brings back the last message" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="150" MinHeight="30" FontSize="14" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource c.Text}" CaretBrush="{DynamicResource c.Text}" VerticalScrollBarVisibility="Auto" Padding="0,5,0,0"/>
            </Grid>
          </DockPanel>
        </Border>
        <TextBlock x:Name="ChatEditing" DockPanel.Dock="Bottom" Margin="22,4,16,0" FontSize="12" Foreground="{DynamicResource c.Accent}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" Text="Editing your last message - Enter sends it in its place, Esc cancels"/>
        <TextBlock x:Name="ChatWorking" DockPanel.Dock="Bottom" Margin="22,4,16,0" FontSize="12" Foreground="{DynamicResource c.Accent}" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
        <Grid>
          <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ChatList" Margin="18,4,16,8"/></ScrollViewer>
          <Border x:Name="ChatMenuPanel" Visibility="Collapsed" Background="{DynamicResource c.Toast}" BorderBrush="{DynamicResource c.Border}" BorderThickness="0,1,0,1">
            <DockPanel>
              <Border DockPanel.Dock="Top" Margin="14,12,14,6" CornerRadius="8" Background="{DynamicResource c.Btn}" BorderBrush="{DynamicResource c.Border}" BorderThickness="1" Padding="10,4">
                <Grid>
                  <TextBlock x:Name="ChatSearchHint" Text="Search conversations..." Foreground="{DynamicResource c.Sub}" FontSize="13" Margin="2,4,0,0" IsHitTestVisible="False"/>
                  <TextBox x:Name="ChatSearch" AutomationProperties.Name="Search the conversations" FontSize="13" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource c.Text}" CaretBrush="{DynamicResource c.Text}" Padding="0,4,0,4"/>
                </Grid>
              </Border>
              <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ChatMenuList" Margin="10,2,10,12"/></ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>
      </DockPanel>
    </Border>
  </Grid>
</Window>
